<h1>Browse plays</h1>

<section class="play-search">
  <%= search_form_for @q,
        html: { data: { turbo_frame: "plays_list" }, class: "play-search__form" } do |f| %>
    <p class="lead">Use the quick search boxes or narrow results with filters below.</p>

    <div class="play-search__grid">
      <div class="play-search__field">
        <%= f.label :play_cont, "Name contains" %>
        <%= f.text_field :play_cont,
              placeholder: "e.g. power, mesh",
              oninput: 'this.form.requestSubmit();' %>
      </div>

      <div class="play-search__field">
        <%= f.label :description_cont, "Description contains" %>
        <%= f.text_field :description_cont,
              placeholder: "keywords or tags",
              oninput: 'this.form.requestSubmit();' %>
      </div>

      <div class="play-search__field">
        <%= f.label :side_of_ball_eq, "Side of ball" %>
        <%= f.select :side_of_ball_eq,
              [["Offense", "Offense"], ["Defense", "Defense"]],
              { include_blank: "Any side" },
              { onchange: 'this.form.requestSubmit();' } %>
      </div>

      <div class="play-search__field">
        <%= f.label :formation_set_formation_id_eq, "Formation" %>
        <%= f.select :formation_set_formation_id_eq,
              options_from_collection_for_select(
                @formations,
                "id",
                "formation_name",
                @q.formation_set_formation_id_eq
              ),
              { include_blank: "Any formation" },
              { onchange: 'this.form.requestSubmit();' } %>
      </div>

      <div class="play-search__field">
        <%= f.label :formation_set_id_eq, "Formation set" %>
        <%= f.select :formation_set_id_eq,
              options_from_collection_for_select(
                @formation_sets,
                "id",
                "formation_set",
                @q.formation_set_id_eq
              ),
              { include_blank: "Any set" },
              { onchange: 'this.form.requestSubmit();' } %>
      </div>

      <div class="play-search__field">
        <%= f.label :playbooks_id_eq, "Playbook" %>
        <%= f.select :playbooks_id_eq,
              options_from_collection_for_select(
                @playbooks,
                "id",
                "playbook_name",
                @q.playbooks_id_eq
              ),
              { include_blank: "Any playbook" },
              { onchange: 'this.form.requestSubmit();' } %>
      </div>
    </div>

    <div class="play-search__actions">
      <% if current_user.present? %>
        <label class="favorite-toggle">
          <%= check_box_tag "favorites_only", "1", params[:favorites_only] == "1",
                onchange: "this.form.requestSubmit();" %>
          Favorites only
        </label>
      <% end %>

      <%= f.submit "Update results", class: "btn btn-primary" %>
      <%= link_to "Clear filters", "/plays", class: "clear-link" %>
    </div>
  <% end %>
</section>

<hr>
<form action="/update_favorites" method="post">
<article>
  <%= turbo_frame_tag "plays_list" do %>
    <table>
      <thead>
        <tr>
          <th>Side of Ball</th>
          <th>Formation</th>      
          <th>Formation Set</th>      
          <th>Play</th>
          <th>Play Art</th>
          <% if current_user.present? %>
          <th>Favorite?</th>
          <% end %>
        </tr>
      </thead>

      <tbody>
        <% @list_of_plays.each do |a_play| %>
          <tr>
            <td>
              <%= a_play.side_of_ball %>
            </td>
            <td>
              <a href="/formations/<%= a_play.formation.id %>">
                <%= a_play.formation.formation_name %>
              </a>
            </td>
            <td>
              <a href="/formation_sets/<%= a_play.formation_set.id %>">
                <%= a_play.formation_set.formation_set %>
              </a>
            </td>
            <td>
              <a href="/plays/<%= a_play.id %>">
                <%= a_play.play %>
              </a>
            </td>
            <td>
              <a href="/plays/<%= a_play.id %>">
                <img src="<%= a_play.play_art %>" style="width:250px;">
              </a>
            </td>
            <% if current_user.present? %>
<td>
  <%= check_box_tag(
        "play_ids[]",
        a_play.id,
        @favorite_play_ids.include?(a_play.id)
      ) %>
</td>
        <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
    <button type="submit">
      Update favorites
    </button>
  </form>
    <hr>

    <!-- ✅ PAGINATION CONTROLS -->
    <article>
      <% if @total_pages > 1 %>
        <nav>
          <%# previous page %>
          <% if @page > 1 %>
            <%= link_to "Previous",
                  url_for(params.permit!.to_h.merge(page: @page - 1)),
                  style: "margin-right: 10px;" %>
          <% end %>

          Page <%= @page %> of <%= @total_pages %>

          <%# next page %>
          <% if @page < @total_pages %>
            <%= link_to "Next",
                  url_for(params.permit!.to_h.merge(page: @page + 1)),
                  style: "margin-left: 10px;" %>
          <% end %>
        </nav>
      <% end %>
    </article>
  <% end %>
</article>

<hr>
