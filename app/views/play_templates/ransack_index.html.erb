<h1>Browse plays</h1>

<section class="play-search">
  <%= search_form_for @q,
        html: { data: { turbo_frame: "plays_list" }, class: "play-search__form" } do |f| %>
    <p class="lead">Use the quick search boxes or narrow results with filters below.</p>

    <div class="play-search__grid">
      <div class="play-search__field">
        <%= f.label :play_cont, "Name contains" %>
        <%= f.text_field :play_cont,
              placeholder: "e.g. power, mesh",
              oninput: 'this.form.requestSubmit();' %>
      </div>

      <div class="play-search__field">
        <%= f.label :description_cont, "Description contains" %>
        <%= f.text_field :description_cont,
              placeholder: "keywords or tags",
              oninput: 'this.form.requestSubmit();' %>
      </div>

      <div class="play-search__field">
        <%= f.label :side_of_ball_eq, "Side of ball" %>
        <%= f.select :side_of_ball_eq,
              [["Offense", "Offense"], ["Defense", "Defense"]],
              { include_blank: "Any side" },
              { onchange: 'this.form.requestSubmit();' } %>
      </div>

      <% formation_selected_ids = Array(@q.formation_set_formation_id_in).reject(&:blank?).map(&:to_i) %>
      <% formation_selected_names = @formations.select { |form| formation_selected_ids.include?(form.id) }.map(&:formation_name) %>
      <% formation_summary =
           if formation_selected_names.empty?
             "Any formation"
           elsif formation_selected_names.length <= 2
             formation_selected_names.join(", ")
           else
             "#{formation_selected_names.first(2).join(", ")} +#{formation_selected_names.length - 2} more"
           end %>
      <div class="play-search__field"
           data-controller="dropdown-multi-select"
           data-dropdown-multi-select-default-label-value="Any formation">
        <%= f.label :formation_set_formation_id_in, "Formation (multi-select)" %>
        <button type="button"
                class="multi-select-toggle"
                data-action="dropdown-multi-select#toggle"
                data-dropdown-multi-select-target="toggle">
          <span data-dropdown-multi-select-target="summary"><%= formation_summary %></span>
          <span class="multi-select-caret">▾</span>
        </button>
        <div class="multi-select-panel"
             data-dropdown-multi-select-target="panel"
             hidden>
          <div class="multi-select-options">
            <%= f.collection_check_boxes(
                  :formation_set_formation_id_in,
                  @formations,
                  :id,
                  :formation_name,
                  { include_hidden: false }
                ) do |b| %>
              <label class="multi-select-option">
                <%= b.check_box(
                      data: {
                        action: "change->dropdown-multi-select#changed",
                        option_label: b.text
                      }
                    ) %>
                <span><%= b.text %></span>
              </label>
            <% end %>
          </div>
        </div>
      </div>

      <% formation_set_selected_ids = Array(@q.formation_set_id_in).reject(&:blank?).map(&:to_i) %>
      <% formation_set_selected_names = @formation_sets.select { |set| formation_set_selected_ids.include?(set.id) }.map(&:formation_set) %>
      <% formation_set_summary =
           if formation_set_selected_names.empty?
             "Any formation set"
           elsif formation_set_selected_names.length <= 2
             formation_set_selected_names.join(", ")
           else
             "#{formation_set_selected_names.first(2).join(", ")} +#{formation_set_selected_names.length - 2} more"
           end %>
      <div class="play-search__field"
           data-controller="dropdown-multi-select"
           data-dropdown-multi-select-default-label-value="Any formation set">
        <%= f.label :formation_set_id_in, "Formation set (multi-select)" %>
        <button type="button"
                class="multi-select-toggle"
                data-action="dropdown-multi-select#toggle"
                data-dropdown-multi-select-target="toggle">
          <span data-dropdown-multi-select-target="summary"><%= formation_set_summary %></span>
          <span class="multi-select-caret">▾</span>
        </button>
        <div class="multi-select-panel"
             data-dropdown-multi-select-target="panel"
             hidden>
          <div class="multi-select-options">
            <%= f.collection_check_boxes(
                  :formation_set_id_in,
                  @formation_sets,
                  :id,
                  :formation_set,
                  { include_hidden: false }
                ) do |b| %>
              <label class="multi-select-option">
                <%= b.check_box(
                      data: {
                        action: "change->dropdown-multi-select#changed",
                        option_label: b.text
                      }
                    ) %>
                <span><%= b.text %></span>
              </label>
            <% end %>
          </div>
        </div>
      </div>

      <div class="play-search__field">
        <%= f.label :playbooks_id_eq, "Playbook" %>
        <%= f.select :playbooks_id_eq,
              options_from_collection_for_select(
                @playbooks,
                "id",
                "playbook_name",
                @q.playbooks_id_eq
              ),
              { include_blank: "Any playbook" },
              { onchange: 'this.form.requestSubmit();' } %>
      </div>
    </div>

    <div class="play-search__actions">
      <% if current_user.present? %>
        <label class="favorite-toggle">
          <%= check_box_tag "favorites_only", "1", params[:favorites_only] == "1",
                onchange: "this.form.requestSubmit();" %>
          Favorites only
        </label>
      <% end %>

      <%= f.submit "Update results", class: "btn btn-primary" %>
      <%= link_to "Clear filters", "/plays", class: "clear-link" %>
    </div>
  <% end %>
</section>

<hr>
<form action="/update_favorites" method="post">
<article>
  <%= turbo_frame_tag "plays_list" do %>
    <table>
      <thead>
        <tr>
          <th>Side of Ball</th>
          <th>Formation</th>      
          <th>Formation Set</th>      
          <th>Play</th>
          <th>Play Art</th>
          <% if current_user.present? %>
          <th>Favorite?</th>
          <% end %>
        </tr>
      </thead>

      <tbody>
        <% @list_of_plays.each do |a_play| %>
          <tr>
            <td>
              <%= a_play.side_of_ball %>
            </td>
            <td>
              <a href="/formations/<%= a_play.formation.id %>">
                <%= a_play.formation.formation_name %>
              </a>
            </td>
            <td>
              <a href="/formation_sets/<%= a_play.formation_set.id %>">
                <%= a_play.formation_set.formation_set %>
              </a>
            </td>
            <td>
              <a href="/plays/<%= a_play.id %>">
                <%= a_play.play %>
              </a>
            </td>
            <td>
              <a href="/plays/<%= a_play.id %>">
                <img src="<%= a_play.play_art %>" style="width:250px;">
              </a>
            </td>
            <% if current_user.present? %>
<td>
  <%= check_box_tag(
        "play_ids[]",
        a_play.id,
        @favorite_play_ids.include?(a_play.id)
      ) %>
</td>
        <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
    <button type="submit">
      Update favorites
    </button>
  </form>
    <hr>

    <!-- ✅ PAGINATION CONTROLS -->
    <article>
      <% if @total_pages > 1 %>
        <nav>
          <%# previous page %>
          <% if @page > 1 %>
            <%= link_to "Previous",
                  url_for(params.permit!.to_h.merge(page: @page - 1)),
                  style: "margin-right: 10px;" %>
          <% end %>

          Page <%= @page %> of <%= @total_pages %>

          <%# next page %>
          <% if @page < @total_pages %>
            <%= link_to "Next",
                  url_for(params.permit!.to_h.merge(page: @page + 1)),
                  style: "margin-left: 10px;" %>
          <% end %>
        </nav>
      <% end %>
    </article>
  <% end %>
</article>

<hr>
